# Sao chép file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.
# Tuyệt đối không đặt tiền tố NEXT_PUBLIC_ cho các biến dưới đây.

# Key TikToday (dạng ttk_live_...), tạo trên dashboard TikToday
TIKTODAY_API_KEY=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Secret ký JWT đăng nhập. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
