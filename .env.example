# Sao chép file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local.
# Tuyệt đối không đặt tiền tố NEXT_PUBLIC_ cho các biến dưới đây.

# Key TikToday (dạng ttk_live_...), tạo trên dashboard TikToday
TIKTODAY_API_KEY=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Secret ký JWT đăng nhập. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Tính năng AI ---
# Chọn nhà cung cấp: gemini (có gói miễn phí, hợp để thử).
# Bỏ trống thì tự chọn: chỉ có GEMINI_API_KEY thì dùng Gemini
AI_PROVIDER=
# Gemini: lấy khoá miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tuỳ chọn, ghi đè model. Mặc định Gemini: gemini-2.5-flash. Mặc định Claude: claude-haiku-5-5 (nhanh) và claude-sonnet-5-5 (hỏi đáp, so sánh)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Trần chi phí AI mỗi ngày (USD, mặc định 1). Gemini gói miễn phí tính 0 nên không chạm trần.
AI_DAILY_BUDGET_USD=
